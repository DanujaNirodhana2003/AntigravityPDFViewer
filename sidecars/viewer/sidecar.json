{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "PDF Viewer",
  "description": "View PDFs in the auxiliary panel with non-locking live reload.",
  "has_web_ui": true,
  "ui_config": {
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "PDF Viewer",
        "file_extensions": [".pdf"]
      }
    ]
  }
}
